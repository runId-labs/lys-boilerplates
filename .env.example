# =========================================================
# Docker infrastructure values (root compose.yaml)
# Copy to .env — keep the shared values in sync with
# api/.env and worker/.env (DB, S3, SMTP).
# =========================================================

# PostgreSQL (user/password/name must match api/.env)
DB_PORT=5432
DB_USER=myapp
DB_PWD=password
DB_NAME=myapp

# Redis
REDIS_PORT=6379

# MailHog
SMTP_PORT=1025

# MinIO (root credentials double as the app's S3 access keys)
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# S3 bucket created by minio-init (must match api/.env S3_BUCKET)
S3_BUCKET=app-files
