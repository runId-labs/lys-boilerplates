# ============================================
# DATABASE
# ============================================

# PostgreSQL host
DB_HOST=localhost
# PostgreSQL port
DB_PORT=5432
# PostgreSQL user
DB_USER=myapp
# PostgreSQL password
DB_PWD=password
# PostgreSQL database name
DB_NAME=myapp
# PostgreSQL SSL mode (require, verify-ca, verify-full — leave empty for dev)
DB_SSL_MODE=

# ============================================
# APPLICATION
# ============================================

# JWT signing key (change in production)
SECRET_KEY=your-secret-key-for-jwt-tokens-change-in-production
# Environment: dev | prod
ENVIRONMENT=dev
# Frontend URL (used for CORS and email links)
FRONT_URL=https://localhost:5173
# GraphQL endpoint URL (used by AI tool executor)
GATEWAY_SERVER_URL=http://localhost:8000

# ============================================
# REDIS / CELERY
# ============================================

# Redis URL for pub/sub (SSE real-time signals)
REDIS_URL=redis://localhost:6379/0
# Celery message broker URL
CELERY_BROKER_URL=redis://localhost:6379/0
# Celery task result storage URL
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================
# EMAIL (SMTP)
# ============================================

# SMTP server host (use MailHog in dev)
SMTP_SERVER=localhost
# SMTP server port (1025 = MailHog default)
SMTP_PORT=1025
# SMTP login (empty for MailHog)
SMTP_LOGIN=
# SMTP password (empty for MailHog)
SMTP_PASSWORD=
# Sender email address
SMTP_SENDER=noreply@myapp.local
# Enable STARTTLS encryption (true in production)
SMTP_STARTTLS=false

# ============================================
# SUPER USER
# ============================================

# Email for auto-created super user at startup (leave empty to disable)
SUPER_USER_EMAIL=
# Language for the super user (default: en)
SUPER_USER_LANGUAGE=en

# ============================================
# AUTH
# ============================================

# Secure flag on auth cookies (true in production, requires HTTPS)
COOKIE_SECURE=false

# ============================================
# MOLLIE (PAYMENTS)
# ============================================

# Mollie API key (test_xxx for sandbox, live_xxx for production)
MOLLIE_API_KEY=
# Public base URL for Mollie webhooks (e.g. https://xxx.ngrok.io). Required for recurring payments.
MOLLIE_WEBHOOK_BASE_URL=

# ============================================
# FILE STORAGE (S3 / MINIO)
# ============================================

# S3 bucket name for file uploads
S3_BUCKET=app-files
# S3/MinIO access key
AWS_ACCESS_KEY_ID=minioadmin
# S3/MinIO secret key
AWS_SECRET_ACCESS_KEY=minioadmin
# S3 region
AWS_REGION=eu-west-1
# S3 endpoint (MinIO URL in dev, omit for AWS S3 in production)
S3_ENDPOINT_URL=http://localhost:9000

# ============================================
# RATE LIMITING
# ============================================

# Requests per minute per IP (default: 60)
RATE_LIMIT_RPM=60
# Requests per minute per authenticated user (default: 300)
RATE_LIMIT_USER_RPM=300
# Requests per minute per internal service (default: 10000)
RATE_LIMIT_SERVICE_RPM=10000
# Enable/disable rate limiting (default: true)
RATE_LIMIT_ENABLED=true

# ============================================
# AI (CHATBOT)
# ============================================

# Mistral AI API key
MISTRAL_API_KEY=
# Anthropic API key (optional — only needed if a purpose is switched to anthropic)
ANTHROPIC_API_KEY=
# Default LLM model name (per-purpose _MODEL variables take precedence)
AI_MODEL=mistral-large-latest
# Per-endpoint provider/model overrides: {PURPOSE}_PROVIDER and {PURPOSE}_MODEL
# (PURPOSE = CHATBOT or TEXT_IMPROVEMENT, provider = mistral | anthropic)
#CHATBOT_PROVIDER=mistral
#CHATBOT_MODEL=mistral-large-latest
#TEXT_IMPROVEMENT_PROVIDER=mistral
#TEXT_IMPROVEMENT_MODEL=mistral-large-latest
# Chatbot sampling temperature (default: 0.3)
#CHATBOT_TEMPERATURE=0.3
# Chatbot reasoning effort — reasoning-capable models only ("none" or "high");
# leave unset for models without reasoning support
#CHATBOT_REASONING_EFFORT=

# ============================================
# ERROR TRACKING (SENTRY)
# ============================================

# Sentry DSN (leave empty to disable).
# Local testing: create a project in GlitchTip (http://localhost:3000, started by
# the root compose.yaml) and paste its DSN here.
SENTRY_DSN=
# Share of HTTP transactions traced for performance (0.0 to 1.0 — keep at 0.0
# unless investigating latency; transactions bury real errors)
SENTRY_TRACES_SAMPLE_RATE=0.0

# ============================================
# SSO (OAUTH2 / OIDC)
# ============================================

# Microsoft SSO client credentials (Azure AD app registration)
MICROSOFT_SSO_CLIENT_ID=
MICROSOFT_SSO_CLIENT_SECRET=
# Microsoft OIDC issuer URL (default: multi-tenant)
MICROSOFT_SSO_ISSUER_URL=https://login.microsoftonline.com/common/v2.0
# Accept sign-ins from any Microsoft directory (default: false — restricted to
# the configured issuer; true requires MICROSOFT_SSO_ALLOWED_TENANTS in practice)
MICROSOFT_SSO_MULTI_TENANT=false
# Comma-separated list of allowed directory (tenant) IDs for multi-tenant setups
MICROSOFT_SSO_ALLOWED_TENANTS=
# Google SSO client credentials (Google Cloud Console)
GOOGLE_SSO_CLIENT_ID=
GOOGLE_SSO_CLIENT_SECRET=
# Google OIDC issuer URL
GOOGLE_SSO_ISSUER_URL=https://accounts.google.com
# Base URL for SSO callback endpoints (must match your API public URL)
SSO_CALLBACK_BASE_URL=https://localhost:8000

# Local SSO testing with the mock-oauth2 container (root compose.yaml):
# uncomment to sign in through the mock providers instead of real Microsoft/Google.
#MICROSOFT_SSO_ISSUER_URL=http://localhost:8080/default
#MICROSOFT_SSO_CLIENT_ID=mock
#MICROSOFT_SSO_CLIENT_SECRET=mock
#GOOGLE_SSO_ISSUER_URL=http://localhost:8080/google
#GOOGLE_SSO_CLIENT_ID=mock
#GOOGLE_SSO_CLIENT_SECRET=mock
