{
  "name": "myapp-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run relay:watch\" \"vite\" --names \"relay,vite\" --prefix-colors \"blue,green\"",
    "build": "relay-compiler && npm run generate:routes && vite build",
    "preview": "vite preview",
    "relay": "relay-compiler",
    "relay:watch": "relay-compiler --watch",
    "generate:routes": "node scripts/generate-routes-manifest.js",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "relay": {
    "src": "src",
    "schema": "./schema.graphql",
    "language": "typescript",
    "eagerEsModules": true,
    "excludes": [
      "**/node_modules/**",
      "**/__mocks__/**",
      "**/__generated__/**"
    ]
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lys-front": "npm:runid-lys@^0.10.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^18.3.1",
    "react-intl": "^7.1.14",
    "react-markdown": "^10.1.0",
    "react-relay": "^18.1.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.6.0",
    "rehype-sanitize": "^6.0.0",
    "relay-runtime": "^18.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.2",
    "@storybook/addon-a11y": "^10.0.6",
    "@storybook/addon-docs": "^10.0.6",
    "@storybook/addon-onboarding": "^10.0.6",
    "@storybook/addon-vitest": "^10.0.6",
    "@storybook/react-vite": "^10.0.6",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/browser-playwright": "^4.0.8",
    "@vitest/coverage-v8": "^4.0.8",
    "babel-plugin-relay": "^18.1.0",
    "concurrently": "^9.2.1",
    "jsdom": "^27.2.0",
    "playwright": "^1.56.1",
    "relay-compiler": "^18.1.0",
    "sass": "^1.81.0",
    "storybook": "^10.0.6",
    "typescript": "^5.9.3",
    "vite": "^6.0.1",
    "vite-plugin-relay": "^2.1.0",
    "vitest": "^4.0.8"
  }
}
